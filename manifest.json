{
  "manifest_version": 3,
  "name": "Website Blocker",
  "version": "0.2",
  "description": "Block distracting websites dynamically.",
  "incognito": "split",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus",
    "alarms",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "dist/block.js"
  },

  "options_page": "options.html",

  "web_accessible_resources": [{
    "resources": ["block.html"],
    "matches": ["<all_urls>"]
  }]
}

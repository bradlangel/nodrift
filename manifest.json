{
  "manifest_version": 3,
  "name": "NoDrift: Website Blocker",
  "short_name": "NoDrift",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "A soft, open-source website blocker for intentional browsing.",
  "incognito": "split",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus",
    "alarms",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "dist/block.js",
    "type": "module"
  },

  "action": {
    "default_title": "NoDrift",
    "default_popup": "popup.html"
  },

  "options_page": "options.html",

  "web_accessible_resources": [{
    "resources": ["block.html", "stats.html"],
    "matches": ["<all_urls>"]
  }]
}
